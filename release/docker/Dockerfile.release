# Select base image based on architecture
ARG TARGETARCH # provided by Docker if using BuildKit. Else pass in explicitly.
ARG ARM64_DIGEST=2e9e964f8a0fdfe40df17e58f379f002418737a1c13e73bb3a35a791bee2a244
ARG X86_DIGEST=57a531fe0f7f90a81acbffb4383e15a1c5b7b8030645961d79a4b180c92e88ea

FROM nvcr.io/nvstaging/tao/data_services_base_image@sha256:${ARM64_DIGEST} AS base-arm64
FROM nvcr.io/nvstaging/tao/data_services_base_image@sha256:${X86_DIGEST} AS base-amd64

FROM base-${TARGETARCH}

WORKDIR /opt/nvidia
COPY dist/*.whl /opt/nvidia/wheels/
RUN ls /opt/nvidia/wheels/
RUN python -m pip install pip --upgrade \
    && cd wheels && ls ./*.whl|xargs -I'{}' python -m pip install '{}' \
    && rm *.whl

# Do NOT install the Ubuntu `ffmpeg` apt package here: the base image ships the
# codec-disabled LGPL-only FFmpeg 8.1 source build (TAO-2183 / FF-4). The apt build
# would reintroduce GPL/royalty codecs (libx264/x265) and the full decoder set,
# including vulnerable ones the source build excludes (e.g. MagicYUV, CVE-2026-8461).
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y libsm6 libxext6 openssl

# NGC Security scan related fixes.
# Low-level packages in apt are updated to resolve published security vulnerabilities ASAP
# We retrieve these updates and upgrade the critical/high vulnerability ones
# python3.12 family + libexpat1 added for the NGC scan of 7.1.0-data-services:
#   - CVE-2026-11940, CVE-2026-11972 (tarfile), CVE-2026-3644 (http.cookies),
#     CVE-2026-7210 (pyexpat hash-flooding), CVE-2026-4224 (Expat DTD stack overflow)
#     — all High, fixed by the patched CPython 3.12 stdlib packages.
#   - libexpat1: CVE-2026-7210 requires libexpat >= 2.8.0 in addition to the
#     CPython patch; also covers the system-expat side of CVE-2026-4224.
RUN apt-get update && \
    apt --only-upgrade install linux-libc-dev -y && \
    apt --only-upgrade install curl -y && \
    apt --only-upgrade install libc-bin -y && \
    apt --only-upgrade install libc6-dev -y && \
    apt --only-upgrade install libc6 -y && \
    apt --only-upgrade install libc-dev-bin -y && \
    apt --only-upgrade install libcurl3-gnutls -y && \
    apt --only-upgrade install libcurl4 -y && \
    apt --only-upgrade install libcurl4-openssl-dev -y && \
    apt --only-upgrade install keyboxd -y && \
    apt --only-upgrade install gpgv -y && \
    apt --only-upgrade install gpgsm -y && \
    apt --only-upgrade install gpgconf -y && \
    apt --only-upgrade install gpg-agent -y && \
    apt --only-upgrade install python3.12 -y && \
    apt --only-upgrade install python3.12-minimal -y && \
    apt --only-upgrade install libpython3.12-stdlib -y && \
    apt --only-upgrade install libpython3.12-minimal -y && \
    apt --only-upgrade install libexpat1 -y

RUN pip install --upgrade pip && \
    python -m pip install --upgrade Werkzeug==3.0.1

# Installing PyTorch
COPY tao-pytorch tao-pytorch
RUN cd tao-pytorch && pip install --upgrade pip setuptools wheel && python setup.py bdist_wheel && \
    find dist/ -name "nvidia_tao_pytorch*.whl" -type f | xargs -n 1 pip install && \
    cd .. && rm -rf tao-pytorch

# Installing TAO-Core
COPY tao-core tao-core
RUN cd tao-core && pip install --upgrade pip setuptools wheel && python setup.py bdist_wheel && \
    find dist/ -name "nvidia_tao_core*.whl" -type f | xargs -n 1 pip install && \
    mkdir -p /etc/nginx/ && cp nvidia_tao_core/microservices/nginx.conf /etc/nginx/ && \
    cd .. && rm -rf tao-core

# NGC Security scan related fixes (Python packages installed via submodule wheels).
# tao-core's requirements.txt pins pydicom==3.0.1 (transitive install), which is below
# the fixed version. We force an upgrade here AFTER the tao-core wheel is installed so
# the final image carries the patched pydicom. pydicom is not directly imported by any
# nvidia_tao_ds, tao-core, or tao-pytorch Python sources, but the package is still
# present in the image and flagged by the scanner.
#   - pydicom 3.0.1 -> 3.0.2 (GHSA-v856-2rf8-9f28 — High)
#   - urllib3 2.6.3 -> 2.7.0 (CVE-2026-44431, CVE-2026-44432 — High; no prior pin)
RUN PIP_CONSTRAINT="" python -m pip install --upgrade "pydicom>=3.0.2" "urllib3>=2.7.0"
# Note: the ffmpeg-in-opencv Critical fix AND the AWS CLI v2 Python Critical fix have
# been moved to docker/Dockerfile (base image) so both base and release scans are clean.
# See base Dockerfile for the rm and aws/install blocks.

RUN rm -rf /opt/nvidia/entrypoint.d/*.txt
COPY release/docker/entrypoint.d/* /opt/nvidia/entrypoint.d/

ENV NVIDIA_PRODUCT_NAME "TAO Toolkit"
ENV TAO_TOOLKIT_VERSION="6.25.10"
ENV NVIDIA_TAO_TOOLKIT_VERSION="${TAO_TOOLKIT_VERSION}-Data-Services"
ENV TAO_TELEMETRY_SERVER="https://api.tao.ngc.nvidia.com"

EXPOSE 8000

# Microservices entrypoint
ENV FLASK_APP=nvidia_tao_core.microservices.app

ENV RUN_CLI=0

CMD if [ "$RUN_CLI" = "1" ]; then \
        /bin/bash; \
    else \
        /bin/bash $(get-microservice-script); \
    fi